DATABASE_URL=postgresql://user:password@host:5432/newnational
SECRET_KEY=generate-with-secrets.token_hex(32)

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (leave dummy values until you have real creds)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Twilio WhatsApp (optional for now)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP=whatsapp:+91XXXXXXXXXX
TWILIO_CONTENT_SID=

# Email notifications (Gmail SMTP)
SMTP_EMAIL=yourgmail@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_ADMIN_EMAIL=admin@youremail.com

# App
APP_NAME=NewNational Footwear Stores
DELIVERY_CHARGE=150
ADMIN_EMAIL=admin@newnational.in
ADMIN_PASSWORD=changeme_use_strong_password
